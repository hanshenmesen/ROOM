# ROOM Profile Agent configuration
# Copy this file to `.env.local`, replace the placeholder key(s), then restart the dev server.
# Never commit `.env.local` or real API keys.

# Primary resume/PDF/image parsing provider.
# Defaults to DeepSeek's official Anthropic-compatible endpoint
# (deepseek-v4-pro), reachable without any internal-network access.
# Note: DeepSeek does not accept image/document content blocks, so PDF-vision
# and image uploads require a multimodal provider (e.g. a MAAS gateway below).
MAAS_API_KEY=your-primary-key
MAAS_API_KEY_FALLBACK=
MAAS_BASE_URL=https://api.deepseek.com/anthropic
MAAS_MODEL=deepseek-v4-pro

# Alternative: an internal OpenAI-compatible MAAS gateway. These identifiers
# are deployment-specific and intentionally NOT tracked in the repository --
# set them locally to make that gateway available end-to-end (protocol
# detection, provider presets in the setup dialog, pricing estimates):
#   INTERNAL_MAAS_HOST=maas.internal.example        # hostname only
#   INTERNAL_MAAS_APP_ID=your-gateway-app-id        # x-maas-app-id header value
#   INTERNAL_MAAS_MODELS=deepseek-v4-pro,some-qwen-model
# Every request also needs an enterprise email for gateway-side auditing:
#   MAAS_USER_EMAIL=you@example.com
# On this protocol, PDFs are parsed from locally extracted text with
# line-numbered evidence; scanned PDFs without a text layer return 422.
# MAAS_BASE_URL=https://maas.internal.example
# MAAS_MODEL=deepseek-v4-pro
# MAAS_USER_EMAIL=you@example.com

# Alternative: an external Anthropic-compatible MAAS gateway (Claude route).
#   EXTERNAL_MAAS_BASE_URL=https://maas.external.example/hackson
#   EXTERNAL_MAAS_MODEL=vertex-claude/claude
#   EXTERNAL_MAAS_FALLBACK_MODEL=bedrock-claude/claude   # optional second route
# MAAS_BASE_URL=https://maas.external.example/hackson
# MAAS_MODEL=vertex-claude/claude

# Optional dedicated provider for personal-website enrichment.
# When omitted, website extraction falls back to the MAAS provider above.
WEBSITE_AGENT_API_KEY=
WEBSITE_AGENT_API_KEY_FALLBACK=
WEBSITE_AGENT_BASE_URL=https://api.zhizengzeng.com/v1
WEBSITE_AGENT_MODEL=claude-sonnet-5

# Optional image-editing provider for AI abstract profile portraits.
# When IMAGE_MAAS_API_KEY is omitted, the server falls back to MAAS_API_KEY.
IMAGE_MAAS_API_KEY=
IMAGE_MAAS_BASE_URL=
IMAGE_MAAS_MODEL=gpt-image-2

# Optional dedicated provider for the lobby companion's profile-grounded QA.
# When omitted, the server falls back to MAAS_API_KEY (and MAAS_USER_EMAIL).
PET_QA_API_KEY=
PET_QA_API_KEY_FALLBACK=
PET_QA_BASE_URL=https://api.deepseek.com/anthropic
PET_QA_MODEL=deepseek-v4-pro

# Only needed when the provider is an internal MAAS gateway that requires
# an enterprise-email header. Ignored by every other provider.
MAAS_USER_EMAIL=
WEBSITE_AGENT_USER_EMAIL=
PET_QA_USER_EMAIL=

# Diagnostics: by default, server-side failure logs emit only structural
# summaries (key paths, types, lengths) so model output never lands in logs.
# Set to 1 in LOCAL development to dump truncated raw payloads instead.
# Never enable on a deployed environment.
# AGENT_DIAGNOSTIC_PAYLOADS=1

# Optional realtime voice for spoken lobby-companion answers.
# These NEXT_PUBLIC values are intentionally browser-visible: never put API keys here.
# No default endpoint is tracked; provide your realtime TTS WebSocket here.
NEXT_PUBLIC_PET_TTS_ENABLED=1
NEXT_PUBLIC_PET_TTS_REALTIME_URL=
NEXT_PUBLIC_PET_TTS_MODEL=Qwen3-TTS-12Hz-1.7B-CustomVoice
NEXT_PUBLIC_PET_TTS_VOICE=vivian
NEXT_PUBLIC_PET_TTS_TASK_TYPE=CustomVoice
NEXT_PUBLIC_PET_TTS_LANGUAGE=Auto
NEXT_PUBLIC_PET_TTS_INSTRUCTIONS=Use a warm, curious, concise companion voice.
NEXT_PUBLIC_PET_TTS_MAX_NEW_TOKENS=1024
