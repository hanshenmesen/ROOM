{
  "name": "room-mvp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node scripts/audit-mardou-layout.mjs && npm run asset:audit && node --test tests/*.test.ts tests/security/*.test.ts && npm run build && node --test tests/rendered-html.test.mjs",
    "asset:audit": "node scripts/audit-mardou-asset.mjs --max-bytes 20971520",
    "asset:optimize": "node scripts/optimize-mardou-asset.mjs public/vendor/mardou/MardouMuseumResult.glb",
    "baseline:agent": "node scripts/agent-baseline.mjs",
    "baseline:agent:update": "node scripts/agent-baseline.mjs --write",
    "eval:profile": "node scripts/profile-eval.mjs",
    "eval:full": "node scripts/profile-eval.mjs --dataset full",
    "eval:compare": "node scripts/profile-eval-compare.mjs",
    "eval:experiment": "node scripts/profile-eval-experiment.mjs",
    "eval:experiment:preflight": "node scripts/profile-eval-experiment.mjs --preflight --write",
    "eval:creative": "node scripts/creative-retrieval-eval.mjs",
    "eval:fixtures": "node scripts/generate-profile-eval-fixtures.mjs",
    "eval:fixtures:update": "node scripts/generate-profile-eval-fixtures.mjs --write",
    "rag:sync": "node scripts/sync-reference-rag.mjs",
    "eval:parser": "node scripts/evaluate-profile-models.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1",
    "unpdf": "^1.8.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
