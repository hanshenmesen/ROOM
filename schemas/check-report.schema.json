{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://room.dev/schemas/check-report.schema.json",
  "title": "ROOM Check Report",
  "type": "object",
  "properties": {
    "passed": {
      "type": "boolean"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "summary": {
      "type": "string"
    },
    "checks": {
      "minItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "passed",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "content",
              "overlap",
              "interaction",
              "performance",
              "navigation"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "message": {
            "type": "string"
          },
          "entityIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "suggestion": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "category",
          "severity",
          "message",
          "entityIds",
          "suggestion"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "passed",
    "score",
    "summary",
    "checks",
    "issues"
  ],
  "additionalProperties": false
}
