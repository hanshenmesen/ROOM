{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creative-retrieval-dataset.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "reviewStatus", "topK", "thresholds", "cases"],
  "properties": {
    "schemaVersion": { "const": "creative-retrieval-dataset.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "reviewStatus": { "enum": ["prelabeled", "human-verified"] },
    "topK": { "type": "integer", "minimum": 1, "maximum": 10 },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recallAtK", "precisionAtK", "ndcg", "licenseViolationRate", "creativeBriefCitationRate"],
      "properties": {
        "recallAtK": { "type": "number", "minimum": 0, "maximum": 1 },
        "precisionAtK": { "type": "number", "minimum": 0, "maximum": 1 },
        "ndcg": { "type": "number", "minimum": 0, "maximum": 1 },
        "licenseViolationRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "creativeBriefCitationRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "query", "purpose", "categories", "relevant"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "query": { "type": "string", "minLength": 1 },
        "purpose": { "enum": ["implementation", "inspiration"] },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["room", "world", "retro", "template", "visual"] }
        },
        "relevant": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["referenceId", "relevance"],
            "properties": {
              "referenceId": { "type": "string", "minLength": 1 },
              "relevance": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "forbiddenReferenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
